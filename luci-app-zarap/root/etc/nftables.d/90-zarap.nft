chain zarap_prerouting {
	type filter hook prerouting priority mangle; policy accept;
	ip saddr @zarap_clients_v4 ip daddr @zarap_direct_v4 return
	ip saddr @zarap_clients_v4 meta l4proto { tcp, udp } meta mark set 0x5a52 tproxy ip to 127.0.0.1:7893 accept
}

chain zarap_killswitch_forward {
	type filter hook forward priority filter + 10; policy accept;
	ip saddr @zarap_clients_v4 ip daddr @zarap_direct_v4 return
	ip saddr @zarap_clients_v4 reject
	ether saddr @zarap_clients_mac ether type ip6 ip6 daddr @zarap_direct_v6 return
	ether saddr @zarap_clients_mac ether type ip6 reject
}

chain zarap_protect_tproxy {
	type filter hook input priority filter - 10; policy accept;
	meta l4proto { tcp, udp } th dport 7893 meta mark != 0x5a52 drop
}
