#!/bin/sh

chmod 0600 /etc/config/zarap 2>/dev/null
mkdir -p /etc/zarap /etc/zarap/assets /tmp/zarap
chmod 0700 /etc/zarap

# Installing Zarap pulls in xray-core, which ships /etc/init.d/xray and its
# default /etc/config/xray. Park the service through the same uci flag Zarap
# sets when it applies, so applying hands control back on its own.
#
# Only the untouched package default is parked: an xray pointed at somebody
# else's configuration, or already pointed at Zarap's, is left alone.
zarap_conf=/etc/zarap/xray.json
xray_conffiles="$(uci -q get xray.config.conffiles)"
xray_confdir="$(uci -q get xray.config.confdir)"

if [ -f /etc/config/xray ] && [ ! -s "$zarap_conf" ] &&
	[ "$xray_conffiles" != "$zarap_conf" ] &&
	{ [ -z "$xray_conffiles" ] || [ "$xray_conffiles" = /etc/xray/config.json ]; } &&
	{ [ -z "$xray_confdir" ] || [ "$xray_confdir" = /etc/xray ]; }; then
	/etc/init.d/xray stop 2>/dev/null
	uci -q set xray.enabled.enabled='0' && uci -q commit xray
	logger -t zarap "xray service parked: package default configuration, waiting for Zarap to apply its own"
fi

# reload, not restart: rpcd re-execs itself on SIGHUP and thaws its sessions,
# so the ucode plugin is picked up without logging the user out of LuCI.
/etc/init.d/rpcd reload 2>/dev/null
/etc/init.d/firewall reload 2>/dev/null

exit 0
