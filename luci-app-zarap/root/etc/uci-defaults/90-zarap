#!/bin/sh

chmod 0600 /etc/config/zarap 2>/dev/null
mkdir -p /etc/zarap /etc/zarap/assets /tmp/zarap
chmod 0700 /etc/zarap

# OpenWrt's xray-core package ships with xray.enabled.enabled='0' by default.
# If the service is already enabled, it was configured and started by the user,
# so installation leaves it untouched; status() reports an unmanaged xray until
# Zarap applies its own configuration.
#
# reload, not restart: rpcd re-execs itself on SIGHUP and thaws its sessions,
# so the ucode plugin is picked up without logging the user out of LuCI.
/etc/init.d/rpcd reload 2>/dev/null
/etc/init.d/firewall reload 2>/dev/null

exit 0
