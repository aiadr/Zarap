#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=20

CONFIG=/etc/zarap/sing-box.json
MARK=0x5a52
ROUTE_TABLE=2022
RULE_PRIORITY=11000

setup_policy_routing() {
	ip -4 rule del priority "$RULE_PRIORITY" 2>/dev/null
	ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null
	ip -4 rule add priority "$RULE_PRIORITY" fwmark "$MARK" lookup "$ROUTE_TABLE" || return 1
	ip -4 route add local 0.0.0.0/0 dev lo table "$ROUTE_TABLE" || return 1
}

clear_policy_routing() {
	ip -4 rule del priority "$RULE_PRIORITY" 2>/dev/null
	ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null
	return 0
}

start_service() {
	local enabled mark route_table
	config_load zarap
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	[ -s "$CONFIG" ] || {
		logger -t zarap "configuration is missing: $CONFIG"
		return 1
	}

	config_get mark main mark "$MARK"
	config_get route_table main route_table "$ROUTE_TABLE"
	MARK="$mark"
	ROUTE_TABLE="$route_table"

	setup_policy_routing || return 1
}

stop_service() {
	clear_policy_routing
}

reload_service() {
	clear_policy_routing
	start
	/etc/init.d/sing-box restart
}

service_triggers() {
	procd_add_reload_trigger zarap
	procd_add_interface_trigger "interface.*.up" lan /etc/init.d/zarap restart
}
