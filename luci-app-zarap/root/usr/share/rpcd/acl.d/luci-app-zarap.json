{
	"luci-app-zarap": {
		"description": "Manage Zarap transparent proxy",
		"read": {
			"ubus": {
				"zarap": [ "status", "validate", "logs", "updates" ]
			},
			"uci": [ "zarap", "dhcp", "network" ]
		},
		"write": {
